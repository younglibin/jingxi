{
  "name": "jingxi-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/*.{ts,tsx}\" \"scripts/*.mjs\" \"*.ts\""
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "type": "module"
}
